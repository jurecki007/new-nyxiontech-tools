    "@playwright/test": "1.64.1",
    "@types/node": "22.18.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
