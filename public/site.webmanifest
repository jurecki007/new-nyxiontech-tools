{
  "id": "/",
  "name": "Nyxiontech PDF Tools",
  "short_name": "PDF Tools",
  "description": "Free, open-source PDF and image tools that run entirely in your browser. Files are never uploaded.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14171c",
  "theme_color": "#14171c",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/pdf": [".pdf"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "image/heic": [".heic"],
        "image/heif": [".heif"]
      },
      "icons": [{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", ".pdf", "image/jpeg", ".jpg", ".jpeg", "image/png", ".png", "image/webp", ".webp", "image/gif", ".gif", "image/heic", ".heic", "image/heif", ".heif"]
        }
      ]
    }
  }
}
